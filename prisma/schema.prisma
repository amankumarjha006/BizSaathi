// BizSaathi Prisma Schema
// PostgreSQL + Prisma 7 ORM

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum PreferredLanguage {
  EN
  HI
  HINGLISH
}

enum DocumentType {
  PURCHASE_INVOICE
  SALES_RECEIPT
  CUSTOMER_ORDER
  EXPENSE_RECEIPT
}

enum ProcessingStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
}

enum TransactionType {
  PURCHASE
  SALE
  CUSTOMER_ORDER
  EXPENSE
  RETURN
}

enum TransactionStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]
}

model Business {
  id                String            @id @default(cuid())
  name              String
  ownerId           String
  businessType      String            @default("KIRANA_RETAIL")
  phone             String?
  preferredLanguage PreferredLanguage @default(HINGLISH)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products       Product[]
  productAliases ProductAlias[]
  customers      Customer[]
  suppliers      Supplier[]
  documents      Document[]
  transactions   Transaction[]
  stockMovements StockMovement[]
  payments       Payment[]
  ledgerEntries  LedgerEntry[]

  @@index([ownerId])
}

model Product {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  sku           String?
  category      String?
  purchasePrice Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  currentStock  Decimal  @default(0) @db.Decimal(12, 3)
  minimumStock  Decimal  @default(0) @db.Decimal(12, 3)
  unit          String   @default("pcs")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aliases          ProductAlias[]
  transactionItems TransactionItem[]
  stockMovements   StockMovement[]

  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([businessId, isActive])
}

model ProductAlias {
  id              String   @id @default(cuid())
  businessId      String
  productId       String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([businessId, normalizedAlias])
  @@index([productId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  ledgerEntries LedgerEntry[]

  @@index([businessId, name])
  @@index([businessId, phone])
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  ledgerEntries LedgerEntry[]

  @@index([businessId, name])
  @@index([businessId, phone])
}

model Document {
  id               String           @id @default(cuid())
  businessId       String
  documentType     DocumentType
  fileName         String
  mimeType         String
  storageKey       String
  processingStatus ProcessingStatus @default(UPLOADED)
  extractedData    Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([businessId, processingStatus])
  @@index([businessId, documentType])
}

model Transaction {
  id              String            @id @default(cuid())
  businessId      String
  transactionType TransactionType
  referenceNumber String?
  transactionDate DateTime          @default(now())
  customerId      String?
  supplierId      String?
  documentId      String?
  totalAmount     Decimal           @db.Decimal(12, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus   PaymentStatus     @default(UNPAID)
  status          TransactionStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier      Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  document      Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  items         TransactionItem[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@index([businessId, createdAt])
  @@index([businessId, transactionDate])
  @@index([businessId, transactionType, status])
  @@index([customerId])
  @@index([supplierId])
}

model TransactionItem {
  id                  String  @id @default(cuid())
  transactionId       String
  productId           String?
  productNameSnapshot String
  quantity            Decimal @db.Decimal(12, 3)
  unitPrice           Decimal @db.Decimal(12, 2)
  totalPrice          Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([productId])
}

model StockMovement {
  id           String            @id @default(cuid())
  businessId   String
  productId    String
  movementType StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  referenceId  String?
  notes        String?
  createdAt    DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([businessId, productId, createdAt])
  @@index([referenceId])
}

model Payment {
  id            String        @id @default(cuid())
  businessId    String
  transactionId String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([transactionId])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  businessId    String
  customerId    String?
  supplierId    String?
  transactionId String
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime        @default(now())

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([businessId, customerId, createdAt])
  @@index([businessId, supplierId, createdAt])
  @@index([transactionId])
}
